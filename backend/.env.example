# PlungePalz Places API — Environment Variables

# Google Places New API v1 Key
GOOGLE_PLACES_API_KEY=

# Anthropic API Key for Claude (AI autofill)
ANTHROPIC_PLUNGEPALZ_PLACES_AI_GENERATOR_API_KEY=

# Claude Model ID (default: claude-3-5-haiku-latest)
ANTHROPIC_MODEL_ID=claude-3-5-haiku-latest

# DynamoDB Table Names (use defaults for local testing)
TABLE_PLACES=Places_Places
TABLE_SUBMISSIONS=Places_Submissions
TABLE_RATINGS=Places_RatingsComments
TABLE_CLAIMED=Places_ClaimedAudit
