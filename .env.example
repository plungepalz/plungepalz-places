# Mapbox public token (required for the interactive map).
# Missing, blank, and this placeholder are treated as no token (map placeholder).
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# PlungePalz Places API base URL (us-east-1 /dev stage).
# Replace <api-id> from the CloudFormation stack output — see README.
# Omit this variable (or set NEXT_PUBLIC_USE_MOCKS=true) to use in-memory mocks.
NEXT_PUBLIC_API_BASE_URL=https://<api-id>.execute-api.us-east-1.amazonaws.com/dev

# Force mock mode even if an API base URL is set
# NEXT_PUBLIC_USE_MOCKS=true
