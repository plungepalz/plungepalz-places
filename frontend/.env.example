# Mapbox public token (required for the interactive map)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# PlungePalz Places API base URL (us-east-1 dev stage; omit to use mock data)
NEXT_PUBLIC_API_BASE_URL=https://your-api-gateway.execute-api.us-east-1.amazonaws.com/dev

# Force mock mode even if an API base URL is set
# NEXT_PUBLIC_USE_MOCKS=true
